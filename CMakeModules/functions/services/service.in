[Unit]
Description=@aTARGET_NAME@
After=syslog.target network.target
Before=shutdown.target


[Service]
EnvironmentFile=-/etc/default/@aTARGET_NAME@.conf
ExecStart=/usr/bin/@aTARGET_NAME@ $OPTARGS
ExecReload=/usr/bin/@aTARGET_NAME@ 
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartPreventExitStatus=1
Type=simple
RuntimeDirectory=sgk
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
Alias=@aTARGET_NAME@