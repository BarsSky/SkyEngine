        //vPos = random+normalize(destPos)*estimatedT*0.5;//+(destPos)*0.5;
        vVel = sqrt(dot(random,random))*1*destPos * (1.0*k-dot(random,random)*0.5)*0.0755/estimatedT;
        living = 0.0;
        alph=1;
        //gradient=0;
    }

    vPos += vVel;
    living += ubo_gpu_particl.deltaT;
    //alpha channel
    
    float buf = sqrt(dot(vPos-random,vPos-random));
    float buf2 = estimatedT-sqrt(dot(random,random));
    float buf3 = estimatedT-sqrt(dot(vPos,vPos));
    //if(buf3<buf2)
        alph -= (buf/buf2)*0.05;
    gradient = 2*alph;//0.7+0.1*alph;
    //     collide with boundary
//    if ((vPos.x < -10.0) || (vPos.x > 10.0) || (vPos.y < -10.0) || (vPos.y > 10.0) || (vPos.z < -10.0) || (vPos.z > 10.0))
//    vVel = (-vVel * 0.1) + attraction(vPos, destPos) * 12;
//    else
    //particles[index].pos.xyz = vPos;
    // Write back
    
    particles[index].vel.xyz = vVel;
    particles[index].lifeTime = living;
    particles[index].pos.xyz = vPos;
    //particles[index].gradientPos.xyz = vec3(1);
    //particles[index].es = estimatedT;
    //particles[index].vel.xyz = vVel;
    particles[index].gradientPos.x = gradient;
    particles[index].gradientPos.y = alph;
    particles[index].gradientPos.z = k;
    if (particles[index].gradientPos.x > 1.0)
    particles[index].gradientPos.x -= 1.0;
}

