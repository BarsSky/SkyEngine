    vec3 deltaTarget = destPos-random;
    //vec3 delta = random - vPos;
    float targetDistance = sqrt(dot(delta, delta));
    float targetDistanceMinus = sqrt(dot(deltaTarget,deltaTarget));
    vVel += repulsion(vPos, destPos.xyz) * 0.05;
    //vVel = vec3(0.0);
	//vVel += delta*0.01;

    float k = estimatedT/3;

    if ((targetDistance > estimatedT) || (living == 0.0) || (living > 10.0))
