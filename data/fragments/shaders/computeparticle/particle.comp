    vec3 destPos = estimatedT*normalize(vec3(ubo_gpu_particl.destX, ubo_gpu_particl.destY, ubo_gpu_particl.destZ));
        if(destPos==vec3(0)){
            particles[index].gradientPos.y = 0;
            return;
        }
    vec3 random = particles[index].randomPos;
